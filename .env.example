# ──────────────────────────────────────────────────────────────
# AuditFlow configuration
# Copy to `.env` and fill in what you need:  cp .env.example .env
# ──────────────────────────────────────────────────────────────

# ── LLM provider ─────────────────────────────────────────────
# Leave both keys empty to run AuditFlow in deterministic Demo Mode.
# The full human-in-the-loop workflow still runs, no API key required.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# PydanticAI model identifier: "<provider>:<model>".
#   OpenAI:    openai:gpt-4o-mini
#   Anthropic: anthropic:claude-3-5-sonnet-latest
# When MODEL_NAME is empty, the provider is inferred from whichever key is set.
MODEL_NAME=openai:gpt-4o-mini

# Fail loudly instead of falling back to the deterministic extractor when the
# LLM call fails (rate limit, invalid response, network error). Default: 0.
AUDITFLOW_STRICT_LLM=0

# ── Runtime ──────────────────────────────────────────────────
# Force the deterministic extractor even when an API key is present (1/0).
AUDITFLOW_DEMO_MODE=0

# SQLite file that stores the audit ledger and duplicate-check history.
AUDITFLOW_DB_PATH=auditflow.db

# Optional JSON-lines sink for every trace step (omit to disable).
AUDITFLOW_TRACE_LOG=logs/auditflow-traces.jsonl

# ── Observability (optional) ─────────────────────────────────
# Set a Logfire token to stream PydanticAI spans to Logfire.
# Leave empty to keep all observability local and offline.
LOGFIRE_TOKEN=
